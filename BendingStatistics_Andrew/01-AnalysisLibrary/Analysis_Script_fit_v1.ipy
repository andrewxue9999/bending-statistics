plt.ylabel("d (um)")
plt.show()
'''

# Combine into 1 figure

x_grid = np.linspace(X.min(), X.max(), 100)
x_grid_local = np.clip(x_grid - fit_x_min, 0, None)
fig, ax= plt.subplots(1, 4, figsize=(18,9))

#Ax 1: Raw data (AFM()
PD.JupiterAFM_plotData_imshow(data_bent, data_labels[1],ax=ax[0],cmap_corr=0.7,cmap='gray')#,snap=True)#, axis, title=True,**plotargs)
ax[0].scatter(Xt,Yt,s=0.1, color='r')
ax[0].axis('off')

#Ax2: Edge data & fits
ax[1].scatter(X, Y, color='black', label='Data')
ax[1].scatter(X[mask], Y[mask], color='tab:blue', label='Data (used for linear unbent fit)')
ax[1].plot(x_grid, parabola(x_grid, *p_opt), '-', color='orange', label='Parabolic Fit')
ax[1].plot(x_grid, line(x_grid, *l_opt), '--', color='crimson',label='Linear Reference')
ax[1].legend()
ax[1].set_xlabel("X (um)")
ax[1].set_ylabel("Y (um)")
ax[1].set_title('Data along edge')

#ax3: displacement
ax[2].scatter(X, deflection_magnitude, color='black', label='Data (masked)')#, label='Snapped Data')
ax[2].scatter(X[mask_d], deflection_magnitude[mask_d], color='tab:blue', label='Data (used for displacement fit)')#, label='Snapped Data')
ax[2].plot(x_grid, deflection_bent_ribbon_local(x_grid_local, *d_opt), '--', c='crimson', label='Displacement Fit')
ax[2].set_title('|Data - linear reference|')
ax[2].set_xlabel("X (um)")
ax[2].set_ylabel("d (um)")

# store legend in variable to later use for positioning textstr text box
leg = ax[2].legend(loc='upper right')
fig.canvas.draw() # Draw the canvas to get the legend's layout geometries before generating final image
bbox = leg.get_window_extent()
bbox_axes = ax[2].transAxes.inverted().transform_bbox(bbox)
text_y = bbox_axes.y0 - 0.01 # prepare to position text box just below legend by 0.01

# Add a text box to the plot
props = dict(boxstyle='round', facecolor='gray', alpha=0.2)
ax[2].text(0.98, text_y, textstr,
        transform=ax[2].transAxes,   # coordinates relative to axes (0-1)
        fontsize=10,
        horizontalalignment='right',
        verticalalignment='top',
        bbox=props
        )

#ax4: local angle
ax[3].scatter(X[mask_twist], theta, color='black')#, label='Snapped Data')
ax[3].set_title('local twist-angle')
ax[3].set_xlabel("X (um)")
ax[3].set_ylabel(f"$ \\Delta \\theta$  (degree)")


# plt.savefig(f"Image05_lowerEdge.png") # CHANGE THIS NAME
plt.savefig(f"results_images/{FILE_NAME}.png")
plt.tight_layout()
